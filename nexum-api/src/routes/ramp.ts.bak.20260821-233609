// ============================================================
// /ramp — Bridge.xyz fiat on/off-ramp routes.
//
// User-facing name is "On/Off-ramp"; the route is /ramp (NOT /bridge, which is
// the CCTP cross-chain bridge).
//
// Phase 0 (read-only):
//   GET  /ramp/health    — config + live reachability (the sandbox smoke test)
//   GET  /ramp/corridors — the data-driven supported-corridor list
// Phase 1 (customer + hosted KYC):
//   GET  /ramp/customer         — this account's ramp/KYC record (or null)
//   POST /ramp/customer         — lazily create a hosted KYC link (individual|business)
//   GET  /ramp/customer/refresh — poll Bridge for latest KYC/ToS status, mirror + return
//   POST /ramp/customer/simulate-approve — SANDBOX ONLY: force KYC approved for testing
// ============================================================

import { Router } from 'express'
import { requireAccount } from '../lib/accountAuth'
import { bridgeXyzConfigured, bridgePing, BRIDGE_IS_SANDBOX } from '../services/bridgexyz/client'
import {
  BRIDGE_LANDING_CHAIN, BRIDGE_LANDING_CHAIN_BRIDGE_ID,
} from '../services/bridgexyz/config'
import {
  createKycLink, getKycLink, simulateKycApproval,
  getCustomerEndorsements, ENDORSEMENT_CURRENCY,
  type BridgeCustomerType,
} from '../services/bridgexyz/customers'
import {
  createVirtualAccount, getVirtualAccountActivity,
  type VirtualAccountActivity,
} from '../services/bridgexyz/virtualAccounts'
import {
  getRampCustomerByAccount, createRampCustomer, updateRampCustomerStatus,
  listEnabledOnrampCorridors, getEnabledOnrampCorridor,
  getVirtualAccountsByAccount, getVirtualAccountByAccountCurrency,
  createVirtualAccountRow,
  getDepositEventsByVirtualAccount, upsertDepositEvent,
  type RampCustomerRow, type RampVirtualAccountRow,
} from '../services/bridgexyz/repository'

const router = Router()

// ---- Phase 0: health + corridors -------------------------------------------

// GET /ramp/health
router.get('/health', async (_req, res) => {
  const configured = bridgeXyzConfigured()
  const base = {
    provider:     'bridgexyz',
    configured,
    env:          BRIDGE_IS_SANDBOX ? 'sandbox' : 'production',
    landingChain: BRIDGE_LANDING_CHAIN,
  }
  if (!configured) {
    return res.json({ ...base, reachable: false, note: 'BRIDGE_API_KEY not set' })
  }
  try {
    await bridgePing()
    res.json({ ...base, reachable: true })
  } catch (err: any) {
    res.status(502).json({
      ...base, reachable: false,
      error: err?.message ?? 'Bridge ping failed', status: err?.status,
    })
  }
})

// GET /ramp/corridors — enabled on-ramp corridors, from the DB table.
router.get('/corridors', async (_req, res) => {
  try {
    const rows = await listEnabledOnrampCorridors()
    const onramp = rows.map(r => ({
      currency:  r.currency,
      label:     r.label,
      minAmount: r.min_amount ?? undefined,
    }))
    res.json({ onramp })
  } catch (err: any) {
    res.status(500).json({ error: err?.message ?? 'Failed to load corridors' })
  }
})

// GET /ramp/endorsements — which currencies this account is approved to deposit.
// Bridge gates each currency behind a per-customer endorsement (base=USD,
// sepa=EUR, spei=MXN, pix=BRL, faster_payments=GBP, cop=COP). We map the
// customer's endorsements onto currencies so the UI can enable only the ready
// ones and explain the rest. Returns { endorsements: { [currency]: {status, approved} } }.
router.get('/endorsements', requireAccount, async (req, res) => {
  const account = (req as any).account
  try {
    const customer = await getRampCustomerByAccount(account.id)
    if (!customer?.customer_id) {
      return res.json({ endorsements: {} })
    }
    let list
    try {
      list = await getCustomerEndorsements(customer.customer_id)
    } catch (err: any) {
      return res.status(err?.status ?? 502).json({
        error: err?.message ?? 'Could not load endorsements',
      })
    }
    const endorsements: Record<string, { status: string; approved: boolean }> = {}
    for (const e of list) {
      const currency = ENDORSEMENT_CURRENCY[e.name]
      if (!currency) continue
      endorsements[currency] = { status: e.status, approved: e.status === 'approved' }
    }
    res.json({ endorsements })
  } catch (err: any) {
    res.status(500).json({ error: err?.message ?? 'Could not load endorsements' })
  }
})

// ---- Phase 1: customer + hosted KYC ----------------------------------------

// Shape returned to the client. We never expose internal ids beyond what the
// UI needs to open the hosted links and render status.
function toClient(row: RampCustomerRow) {
  return {
    customerType: row.customer_type,
    kycStatus:    row.kyc_status,
    tosStatus:    row.tos_status,
    kycLink:      row.kyc_link,
    tosLink:      row.tos_link,
    customerId:   row.customer_id,
    rejectionReasons: row.rejection_reasons ? safeParse(row.rejection_reasons) : [],
    // Convenience flag the gate UI keys off.
    verified:     row.kyc_status === 'approved' && row.tos_status === 'approved',
  }
}

function safeParse(s: string): unknown {
  try { return JSON.parse(s) } catch { return [] }
}

// GET /ramp/customer — the current account's record, or { exists: false }.
router.get('/customer', requireAccount, async (req, res) => {
  const account = (req as any).account
  try {
    const row = await getRampCustomerByAccount(account.id)
    if (!row) return res.json({ exists: false })
    res.json({ exists: true, ...toClient(row) })
  } catch (err: any) {
    res.status(500).json({ error: err?.message ?? 'Failed to load ramp customer' })
  }
})

// POST /ramp/customer — lazily create a hosted KYC link for this account.
// Body: { type?: 'individual' | 'business', fullName: string }
// email is taken from the signed-in account. Idempotent per account: if a
// record already exists we return it rather than creating a second link.
router.post('/customer', requireAccount, async (req, res) => {
  const account = (req as any).account
  if (!bridgeXyzConfigured()) {
    return res.status(503).json({ error: 'On/off-ramp is not available right now' })
  }

  const type = ((req.body?.type as BridgeCustomerType) === 'business')
    ? 'business' : 'individual'
  const fullName = String(req.body?.fullName ?? '').trim()
  if (!fullName) return res.status(400).json({ error: 'Your legal name is required' })
  if (!account.email) return res.status(400).json({ error: 'Your account has no email on file' })

  try {
    // Already onboarded (or mid-flight)? Return the existing record.
    const existing = await getRampCustomerByAccount(account.id)
    if (existing) return res.json({ exists: true, ...toClient(existing) })

    // Stable idempotency key per account so a double-submit can't mint two links.
    const link = await createKycLink({
      fullName, email: account.email, type,
      idempotencyKey: `ramp-kyc-${account.id}`,
    })

    const row = await createRampCustomer({
      accountId:    account.id,
      customerType: type,
      kycLinkId:    link.id,
      customerId:   link.customer_id,
      kycLink:      link.kyc_link,
      tosLink:      link.tos_link,
      kycStatus:    link.kyc_status,
      tosStatus:    link.tos_status,
    })
    res.json({ exists: true, ...toClient(row) })
  } catch (err: any) {
    res.status(err?.status ?? 502).json({ error: err?.message ?? 'Could not start verification' })
  }
})

// GET /ramp/customer/refresh — poll Bridge for latest status, mirror, return.
// Used while the user completes the hosted flow in another tab.
router.get('/customer/refresh', requireAccount, async (req, res) => {
  const account = (req as any).account
  try {
    const row = await getRampCustomerByAccount(account.id)
    if (!row) return res.json({ exists: false })
    if (!row.kyc_link_id) return res.json({ exists: true, ...toClient(row) })

    const link = await getKycLink(row.kyc_link_id)
    await updateRampCustomerStatus({
      accountId:  account.id,
      kycStatus:  link.kyc_status,
      tosStatus:  link.tos_status,
      customerId: link.customer_id,
      rejectionReasons: link.rejection_reasons?.length
        ? JSON.stringify(link.rejection_reasons) : null,
    })
    const updated = await getRampCustomerByAccount(account.id)
    res.json({ exists: true, ...toClient(updated as RampCustomerRow) })
  } catch (err: any) {
    res.status(err?.status ?? 502).json({ error: err?.message ?? 'Could not refresh status' })
  }
})

// POST /ramp/customer/simulate-approve — SANDBOX ONLY.
// Forces the customer to KYC-approved via Bridge's sandbox endpoint so the
// gate can be tested without a real Persona verification. Refused in prod.
router.post('/customer/simulate-approve', requireAccount, async (req, res) => {
  if (!BRIDGE_IS_SANDBOX) {
    return res.status(403).json({ error: 'Not available in production' })
  }
  const account = (req as any).account
  try {
    const row = await getRampCustomerByAccount(account.id)
    if (!row?.customer_id) {
      return res.status(400).json({
        error: 'No Bridge customer id yet — the KYC link must be started first.',
      })
    }
    await simulateKycApproval(row.customer_id, `ramp-sim-${account.id}-${Date.now()}`)
    // Re-poll so our mirror reflects the forced approval.
    if (row.kyc_link_id) {
      const link = await getKycLink(row.kyc_link_id)
      await updateRampCustomerStatus({
        accountId:  account.id,
        kycStatus:  link.kyc_status,
        tosStatus:  link.tos_status,
        customerId: link.customer_id,
      })
    }
    const updated = await getRampCustomerByAccount(account.id)
    res.json({ exists: true, ...toClient(updated as RampCustomerRow) })
  } catch (err: any) {
    res.status(err?.status ?? 502).json({ error: err?.message ?? 'Simulate approval failed' })
  }
})

// ---- Phase 2: virtual accounts (on-ramp deposit rails) ---------------------

// Shape a stored virtual-account row for the client: enough to render deposit
// instructions and the status tracker, no internal ids the UI doesn't need.
function vaToClient(row: RampVirtualAccountRow) {
  return {
    currency:            row.currency,
    virtualAccountId:    row.virtual_account_id,
    destinationAddress:  row.destination_address,
    destinationChain:    row.destination_chain,
    status:              row.status,
    depositInstructions: row.deposit_instructions
      ? safeParse(row.deposit_instructions) : null,
    createdAt:           row.created_at,
  }
}

// Guard: the account must be a verified Bridge customer before any rail.
async function requireVerifiedCustomer(accountId: string): Promise<
  { ok: true; customer: RampCustomerRow } | { ok: false; status: number; error: string }
> {
  const customer = await getRampCustomerByAccount(accountId)
  if (!customer) {
    return { ok: false, status: 409, error: 'Verify your identity before setting up deposits' }
  }
  if (!(customer.kyc_status === 'approved' && customer.tos_status === 'approved')) {
    return { ok: false, status: 409, error: 'Your verification isn’t approved yet' }
  }
  if (!customer.customer_id) {
    return { ok: false, status: 409, error: 'Your verification is still finalizing — try again shortly' }
  }
  return { ok: true, customer }
}

// GET /ramp/virtual-accounts — this account's deposit rails.
router.get('/virtual-accounts', requireAccount, async (req, res) => {
  const account = (req as any).account
  try {
    const rows = await getVirtualAccountsByAccount(account.id)
    res.json({ virtualAccounts: rows.map(vaToClient) })
  } catch (err: any) {
    res.status(500).json({ error: err?.message ?? 'Failed to load deposit accounts' })
  }
})

// POST /ramp/virtual-account — lazily create (or return) the deposit rail for a
// currency. Body: { currency: string }. Mirrors the lazy ramp_customers create:
// one virtual account per account+currency, idempotent per that pair.
router.post('/virtual-account', requireAccount, async (req, res) => {
  const account = (req as any).account
  if (!bridgeXyzConfigured()) {
    return res.status(503).json({ error: 'On/off-ramp is not available right now' })
  }

  const currency = String(req.body?.currency ?? '').trim().toLowerCase()
  if (!currency) return res.status(400).json({ error: 'A currency is required' })

  try {
    // Currency must be an enabled corridor.
    const corridor = await getEnabledOnrampCorridor(currency)
    if (!corridor) {
      return res.status(400).json({ error: 'That currency isn’t available for deposits' })
    }

    // Already provisioned for this currency? Return it (idempotent).
    const existing = await getVirtualAccountByAccountCurrency(account.id, currency)
    if (existing) return res.json({ virtualAccount: vaToClient(existing) })

    // Must be a verified customer.
    const gate = await requireVerifiedCustomer(account.id)
    if (!gate.ok) return res.status(gate.status).json({ error: gate.error })

    // Destination = the user's Circle wallet on Base. Circle user-controlled
    // wallets share ONE address across EVM chains, so the account's stored
    // wallet address is the Base address.
    const destinationAddress = account.walletAddress
    if (!destinationAddress) {
      return res.status(409).json({
        error: 'Your wallet isn’t ready yet — please try again in a moment',
      })
    }

    const va = await createVirtualAccount({
      customerId:         gate.customer.customer_id as string,
      sourceCurrency:     currency,
      destinationAddress,
      destinationChain:   BRIDGE_LANDING_CHAIN_BRIDGE_ID,
      developerFeePercent: '0',
      idempotencyKey:     `ramp-va-${account.id}-${currency}`,
    })

    const row = await createVirtualAccountRow({
      accountId:           account.id,
      currency,
      bridgeCustomerId:    gate.customer.customer_id as string,
      virtualAccountId:    va.id,
      destinationAddress,
      destinationChain:    BRIDGE_LANDING_CHAIN,
      depositInstructions: va.source_deposit_instructions
        ? JSON.stringify(va.source_deposit_instructions) : null,
      status:              va.status ?? 'activated',
    })

    res.json({ virtualAccount: vaToClient(row) })
  } catch (err: any) {
    // Bridge rejects currencies the customer isn't endorsed for with a message
    // like "Customer does not have an appropriate endorsement to transact."
    // Surface that as a clear, currency-specific message instead of the raw text.
    const raw = String(err?.message ?? '')
    if (/endorsement/i.test(raw)) {
      return res.status(409).json({
        error: `${currency.toUpperCase()} deposits aren’t enabled on your account yet. This currency needs additional approval from our partner.`,
        code:  'endorsement_required',
        currency,
      })
    }
    res.status(err?.status ?? 502).json({ error: err?.message ?? 'Could not set up deposits' })
  }
})

// GET /ramp/virtual-account/:currency/activity — deposit -> delivered events.
// Polled by the status tracker. MERGES two sources:
//   • Bridge's /history poll — GROUND TRUTH, always authoritative.
//   • ramp_deposit_events   — the webhook mirror, which may be fresher (a
//     webhook can land before the next 15s poll). Used only to fill in event
//     types the poll hasn't returned yet, so the stepper advances instantly.
// If Bridge's /history call fails, we still return the mirror so the tracker
// degrades gracefully rather than erroring.
router.get('/virtual-account/:currency/activity', requireAccount, async (req, res) => {
  const account = (req as any).account
  const currency = String(req.params.currency ?? '').trim().toLowerCase()
  try {
    const row = await getVirtualAccountByAccountCurrency(account.id, currency)
    if (!row) return res.status(404).json({ error: 'No deposit account for that currency' })

    const gate = await requireVerifiedCustomer(account.id)
    if (!gate.ok) return res.status(gate.status).json({ error: gate.error })

    // Ground truth: Bridge /history. Tolerate failure (fall back to mirror).
    let pollEvents: any[] = []
    let pollFailed = false
    try {
      const activity = await getVirtualAccountActivity(
        gate.customer.customer_id as string, row.virtual_account_id)
      pollEvents = Array.isArray(activity?.data) ? activity.data : []
    } catch {
      pollFailed = true
    }

    // Webhook mirror (may be fresher). Reconcile: anything only the mirror knows
    // gets written back into the mirror as 'poll' source when the poll catches
    // up — but for the response we just union by event type.
    let mirrorEvents: any[] = []
    try {
      const rows = await getDepositEventsByVirtualAccount(row.virtual_account_id)
      mirrorEvents = rows.map(r => ({
        id:                  r.id,
        type:                r.event_type,
        deposit_id:          r.deposit_id,
        amount:              r.amount ?? undefined,
        currency:            r.currency ?? undefined,
        destination_tx_hash: r.destination_tx_hash ?? undefined,
        receipt:             r.receipt_url ? { url: r.receipt_url } : undefined,
        _source:             r.source,
      }))
    } catch { /* mirror is best-effort */ }

    // Union: start from the poll (authoritative), then add any mirror event
    // whose (deposit_id,type) the poll hasn't reported yet.
    const seen = new Set(
      pollEvents.map(e => `${e.deposit_id ?? ''}:${e.type ?? ''}`))
    const merged = [...pollEvents]
    for (const m of mirrorEvents) {
      const key = `${m.deposit_id ?? ''}:${m.type ?? ''}`
      if (!seen.has(key)) { merged.push(m); seen.add(key) }
    }

    // Reconcile the other direction: poll events the mirror is missing get
    // written into the mirror (source 'poll') so a webhook that never arrived
    // doesn't leave a gap. Best-effort, never blocks the response.
    if (!pollFailed) {
      const mirrorKeys = new Set(
        mirrorEvents.map(m => `${m.deposit_id ?? ''}:${m.type ?? ''}`))
      for (const e of pollEvents) {
        const key = `${e.deposit_id ?? ''}:${e.type ?? ''}`
        if (!mirrorKeys.has(key) && e.type) {
          upsertDepositEvent({
            virtualAccountId:  row.virtual_account_id,
            depositId:         e.deposit_id ?? null,
            eventType:         e.type,
            currency:          e.currency ?? null,
            amount:            e.amount ?? null,
            destinationTxHash: e.destination_tx_hash ?? e.receipt?.destination_tx_hash ?? null,
            receiptUrl:        e.receipt?.url ?? null,
            source:            'poll',
          }).catch(() => { /* best-effort reconcile */ })
        }
      }
    }

    res.json({
      currency,
      count:  merged.length,
      events: merged,
      source: pollFailed ? 'mirror' : 'merged',
    })
  } catch (err: any) {
    res.status(500).json({ error: err?.message ?? 'Could not load deposit activity' })
  }
})

export default router
