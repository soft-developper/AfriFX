DECODED="$TMP/page.tsx"
if ! base64 --decode "$TMP/page.b64" > "$DECODED" 2>/dev/null; then
  echo "ERROR: decode failed for page.tsx — aborting, $PAGE untouched." >&2; exit 1; fi
if [ ! -s "$DECODED" ]; then
  echo "ERROR: decoded page.tsx empty — aborting." >&2; exit 1; fi
if ! grep -q "function OfframpFlow" "$DECODED" || ! grep -q "export default function RampPage" "$DECODED"; then
  echo "ERROR: page.tsx markers missing from decode — aborting." >&2; exit 1; fi
cp "$PAGE" "$PAGE.bak.$STAMP"
cp "$DECODED" "$PAGE"
if ! grep -q "function OfframpFlow" "$PAGE"; then
  echo "ERROR: page.tsx post-write verification failed — restoring backup." >&2
  cp "$PAGE.bak.$STAMP" "$PAGE"; exit 1; fi
echo "  wrote $PAGE ($(wc -l < "$PAGE") lines; backup at $PAGE.bak.$STAMP)"
fi

