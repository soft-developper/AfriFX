#!/usr/bin/env bash
# ============================================================
# ramp-phase5-part3-offramp-ui.sh
#
# Phase 5 (OFF-RAMP) — Part 3: the UI at /ramp.
# WEB-ONLY. Depends on Part 2 (offramp API routes) at runtime.
#
# Adds a direction toggle (Add money | Withdraw) to the verified /ramp view and
# a full off-ramp flow that MIRRORS the on-ramp flow:
#   currency grid → bank-details form (currency-branched: US / IBAN / CLABE)
#   → withdraw card (sends USDC via the SAME Circle-signed sendUsdc path as
#     multichain send, to the Bridge liquidation address) → drain status tracker
#     (funds_received → payment_submitted → payment_processed).
#
# Two files, both under nexum-web:
#   EDIT hooks/useRamp.ts                 (append useOfframp() + offramp types)
#   EDIT app/(app)/ramp/page.tsx          (whole-file replace: adds toggle + offramp UI)
#
# On-ramp code is untouched; the off-ramp flow reuses meta()/Step/ErrorNote and
# the same card/tracker visual language. No auto-scroll anywhere.
#
# v2 delivery: each payload → own quoted-heredoc temp file → decode → verify
# (decode-ok + non-empty + marker present) BEFORE replacing the target.
# useRamp.ts is an APPEND guarded by a marker; page.tsx is a whole-file replace
# (no partial-apply risk). Idempotent. --revert restores timestamped backups
# (and strips the useRamp append).
#
# ⚠ PREREQUISITE: Parts 1+2 (API). This script checks the web hook doesn't
# already have the append and that page.tsx exists; it does NOT hard-require the
# API (web compiles independently), but the flow only works once the API is live.
#
# Usage:
#   bash ramp-phase5-part3-offramp-ui.sh          # apply
#   bash ramp-phase5-part3-offramp-ui.sh --revert # undo
# ============================================================
set -euo pipefail

STAMP="$(date +%Y%m%d-%H%M%S)"

if [ -d "nexum-web" ]; then WEB="nexum-web"
elif [ -d "../nexum-web" ]; then WEB="../nexum-web"
elif [ -f "package.json" ] && grep -q '"name": *"nexum-web"\|afrifx-web' package.json 2>/dev/null; then WEB="."
else echo "ERROR: run from the repo root (~/AfriFX) or nexum-web." >&2; exit 1; fi
echo "Using WEB package at: $WEB"

HOOK="$WEB/hooks/useRamp.ts"
PAGE="$WEB/app/(app)/ramp/page.tsx"
HOOK_MARKER="export function useOfframp"
PAGE_MARKER="function OfframpFlow"

if [ ! -f "$HOOK" ]; then echo "ERROR: $HOOK not found." >&2; exit 1; fi
if [ ! -f "$PAGE" ]; then echo "ERROR: $PAGE not found." >&2; exit 1; fi

# ---- revert -----------------------------------------------------------------
if [ "${1:-}" = "--revert" ]; then
  echo "Reverting Phase 5 Part 3..."
  # page.tsx: restore newest backup.
  BK="$(ls -t "$PAGE".bak.* 2>/dev/null | head -1 || true)"
  if [ -n "$BK" ]; then cp "$BK" "$PAGE"; echo "  restored $PAGE from $BK"
  else echo "  no page.tsx backup found — left as-is"; fi
  # useRamp.ts: restore newest backup (removes the append).
  HBK="$(ls -t "$HOOK".bak.* 2>/dev/null | head -1 || true)"
  if [ -n "$HBK" ]; then cp "$HBK" "$HOOK"; echo "  restored $HOOK from $HBK"
  else echo "  no useRamp.ts backup found — left as-is"; fi
  echo "Revert complete. Re-run: cd $WEB && rm -rf .next && npx tsc --noEmit && npm run build"
  exit 0
fi

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

# ---- edit: append useOfframp() to hooks/useRamp.ts ----
